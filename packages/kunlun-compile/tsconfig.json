{
  "compilerOptions": {
    "target": "ES6",
    "module": "esnext",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {},
    "lib": ["ES2020", "ESNext", "DOM", "DOM.Iterable", "ScriptHost"],
    "types": ["node"],
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["index.ts", "src"],
  "exclude": ["node_modules", "dist"]
}
