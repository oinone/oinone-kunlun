{
  "name": "@oinone/kunlun-vue-mobile-base",
  "version": "7.2.6",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "rimraf dist package-lock.json node_modules",
    "prebuild": "rimraf dist",
    "build": "rollup -c && npm run build-css",
    "build-css": "sass --style compressed --no-source-map ./dist/oinone-kunlun-vue-mobile-base.scss ./dist/oinone-kunlun-vue-mobile-base.css",
    "build-css-rem": "node ../../scripts/px2rem.js ./dist/oinone-kunlun-vue-mobile-base.css",
    "dist": "npm run prepublishOnly",
    "index": "npm run postpublish",
    "format": "prettier --write --experimental-cli src/",
    "test": "jest",
    "prepublishOnly": "node ../../../../scripts/prepublish-only.cjs",
    "deploy": "npm publish --exact",
    "postpublish": "node ../../../../scripts/postpublish.cjs",
    "doc": "typedoc --out docs src/index.ts"
  },
  "dependencies": {
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-vue": "5.1.11",
    "@wangeditor/plugin-upload-attachment": "1.1.0",
    "crypto-js": "4.1.1",
    "dom7": "^4.0.4",
    "lodash-es": "4.17.21",
    "smooth-signature": "1.0.15",
    "vxe-table": "4.3.6",
    "xe-utils": "3.5.7"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@dcloudio/types": "2.6.12",
    "@oinone/kunlun-compile": "~7.2.0",
    "@oinone/kunlun-dsl": "~7.2.0",
    "@oinone/kunlun-engine": "~7.2.0",
    "@oinone/kunlun-event": "~7.2.0",
    "@oinone/kunlun-expression": "~7.2.0",
    "@oinone/kunlun-meta": "~7.2.0",
    "@oinone/kunlun-request": "~7.2.0",
    "@oinone/kunlun-router": "~7.2.0",
    "@oinone/kunlun-service": "~7.2.0",
    "@oinone/kunlun-shared": "~7.2.0",
    "@oinone/kunlun-spi": "~7.2.0",
    "@oinone/kunlun-state": "~7.2.0",
    "@oinone/kunlun-theme": "~7.2.0",
    "@oinone/kunlun-vue-router": "~7.2.0",
    "@oinone/kunlun-vue-ui-common": "~7.2.0",
    "@oinone/kunlun-vue-ui-mobile-vant": "7.2.6",
    "@oinone/kunlun-vue-widget": "~7.2.0",
    "@types/crypto-js": "4.1.1",
    "@types/lodash-es": "4.17.6",
    "dayjs": "1.10.7",
    "moment": "2.29.3",
    "vant": "4.9.22",
    "vuedraggable": "4.1.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.26",
    "vue-types": "^3.0.2"
  },
  "gitHead": "2b4c0c7911626c105ca71c2d41e54af470e2e079"
}
