{
  "name": "@oinone/kunlun-vue-ui-mobile-vant",
  "version": "6.4.2",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rollup -c && npm run build-css && npm run build-css-rem",
    "build-css": "sass --style compressed --no-source-map ./dist/oinone-kunlun-vue-ui-mobile-vant.scss ./dist/oinone-kunlun-vue-ui-mobile-vant.css",
    "build-css-rem": "node ../../scripts/px2rem.js ./dist/oinone-kunlun-vue-ui-mobile-vant.css",
    "dist": "npm run prepublishOnly",
    "index": "npm run postpublish",
    "prepublishOnly": "node ../../../../scripts/prepublish-only.cjs",
    "deploy": "npm publish --exact",
    "postpublish": "node ../../../../scripts/postpublish.cjs",
    "doc": "typedoc --out docs src/index.ts"
  },
  "dependencies": {
    "@vant/compat": "1.0.1",
    "lodash-es": "4.17.21",
    "vant": "4.9.22",
    "vue": "3.5.26"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "6.1.0",
    "@oinone/kunlun-compile": "~6.4.0",
    "@oinone/kunlun-shared": "~6.4.0",
    "@oinone/kunlun-vue-ui-common": "~6.4.0",
    "@types/lodash-es": "4.17.6",
    "less": "4.5.1",
    "less-loader": "12.3.0",
    "moment": "2.29.3",
    "sass": "1.97.0",
    "sass-loader": "16.0.6"
  },
  "peerDependencies": {
    "vue": ">=3.5.26"
  },
  "gitHead": "2b4c0c7911626c105ca71c2d41e54af470e2e079"
}
