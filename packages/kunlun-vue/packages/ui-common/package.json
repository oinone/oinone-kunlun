{
  "name": "@oinone/kunlun-vue-ui-common",
  "version": "7.2.13",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "rimraf dist package-lock.json node_modules",
    "prebuild": "rimraf dist",
    "build": "rollup -c && npm run build-css",
    "build-css": "sass --style compressed --no-source-map ./dist/oinone-kunlun-vue-ui-common.scss ./dist/oinone-kunlun-vue-ui-common.css",
    "dist": "npm run prepublishOnly",
    "index": "npm run postpublish",
    "format": "prettier --write --experimental-cli src/",
    "test": "jest",
    "prepublishOnly": "node ../../../../scripts/prepublish-only.cjs",
    "deploy": "npm publish --exact",
    "postpublish": "node ../../../../scripts/postpublish.cjs",
    "doc": "typedoc --out docs src/index.ts"
  },
  "dependencies": {
    "lodash-es": "4.17.21"
  },
  "devDependencies": {
    "@oinone/kunlun-engine": "~7.2.0",
    "@oinone/kunlun-meta": "~7.2.0",
    "@oinone/kunlun-request": "~7.2.0",
    "@oinone/kunlun-shared": "~7.2.0",
    "@types/lodash-es": "4.17.6",
    "@vue/shared": "3.5.26",
    "rollup-plugin-copy": "3.4.0",
    "sass": "1.97.0",
    "sass-loader": "16.0.6",
    "vue": "3.5.26"
  },
  "gitHead": "2b4c0c7911626c105ca71c2d41e54af470e2e079"
}
