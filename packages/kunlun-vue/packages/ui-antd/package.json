{
  "name": "@oinone/kunlun-vue-ui-antd",
  "version": "6.4.2",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rollup -c && npm run build-css",
    "build-css": "sass --style compressed --no-source-map ./dist/oinone-kunlun-vue-ui-antd.scss ./dist/oinone-kunlun-vue-ui-antd.css",
    "dist": "npm run prepublishOnly",
    "index": "npm run postpublish",
    "prepublishOnly": "node ../../../../scripts/prepublish-only.cjs",
    "deploy": "npm publish --exact",
    "postpublish": "node ../../../../scripts/postpublish.cjs",
    "doc": "typedoc --out docs src/index.ts"
  },
  "dependencies": {
    "@oinone/kunlun-vue-ui-common": "6.4.2"
  },
  "devDependencies": {
    "@oinone/kunlun-shared": "~6.4.0",
    "@types/lodash": "4.17.21",
    "@types/lodash-es": "4.17.6",
    "ant-design-vue": "4.2.6",
    "lodash": "4.17.21",
    "lodash-es": "4.17.21",
    "moment": "2.29.3",
    "sass": "1.97.0",
    "sass-loader": "16.0.6",
    "vue": "3.5.26"
  },
  "peerDependencies": {
    "ant-design-vue": ">=4.2.6",
    "moment": ">=2.29.3",
    "vue": ">=3.5.26"
  },
  "gitHead": "2b4c0c7911626c105ca71c2d41e54af470e2e079"
}