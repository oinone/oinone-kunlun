{
  "name": "@oinone/kunlun-vue-ui",
  "version": "7.2.2",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rollup -c && npm run build-css",
    "build-css": "sass --style compressed --no-source-map ./dist/oinone-kunlun-vue-ui.scss ./dist/oinone-kunlun-vue-ui.css",
    "dist": "npm run prepublishOnly",
    "index": "npm run postpublish",
    "format": "prettier --write --experimental-cli src/",
    "test": "jest",
    "prepublishOnly": "node ../../../../scripts/prepublish-only.cjs",
    "deploy": "npm publish --exact",
    "postpublish": "node ../../../../scripts/postpublish.cjs",
    "doc": "typedoc --out docs src/index.ts"
  },
  "dependencies": {
    "@oinone/kunlun-vue-ui-antd": "7.2.2",
    "@oinone/kunlun-vue-ui-common": "7.2.2",
    "sortablejs": "1.14.0",
    "vue3-draggable-resizable": "1.6.5",
    "vue3-smooth-dnd": "0.0.6",
    "vuedraggable": "4.1.0",
    "vxe-table": "4.3.6",
    "vxe-table-plugin-antd": "3.0.6",
    "vxe-table-plugin-element": "3.0.6",
    "xe-utils": "3.5.7"
  },
  "devDependencies": {
    "@oinone/kunlun-shared": "~7.2.0",
    "@types/lodash": "4.17.21",
    "@types/lodash-es": "4.17.6",
    "lodash": "4.17.21",
    "lodash-es": "4.17.21",
    "sass": "1.97.0",
    "sass-loader": "16.0.6"
  },
  "peerDependencies": {
    "vue": ">=3.5.26",
    "vuedraggable": ">=4.1.0"
  },
  "gitHead": "2b4c0c7911626c105ca71c2d41e54af470e2e079"
}
