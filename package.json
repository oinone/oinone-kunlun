{
  "name": "oinone-kunlun",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/kunlun-framework/packages/*",
    "packages/kunlun-engine",
    "packages/kunlun-vue/packages/*",
    "packages/kunlun-expression",
    "packages/kunlun-mobile-vue/packages/*"
  ],
  "scripts": {
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "clean": "lerna clean -y && lerna run clean",
    "postclean": "rimraf package-lock.json node_modules",
    "build": "lerna run build --parallel",
    "dev": "lerna exec npm run dev --scope",
    "lint": "lint-staged",
    "lint:all": "eslint --quiet --fix",
    "patch": "patch-package",
    "test": "lerna run test",
    "publish": "lerna publish --no-git-reset --skip-git --exact -y",
    "type-check": "vue-tsc --build"
  },
  "devDependencies": {
    "@build-test/compile": "6.4.0"
  }
}